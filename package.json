{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.html",
    "start": "NODE_ENV=production bun run build.ts && bun run serve",
    "serve": "bun -e \"const { serve } = require('bun'); serve({ static: { '/': './dist/index.html' }, fetch(req) { return new Response('Not Found', { status: 404 }); }, port: 3000 });\"",
    "build": "bun run lint && bun run build.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "oxlint --type-aware src",
    "lint:fix": "oxlint --type-aware --fix src",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "^6.6.1",
    "bun-plugin-tailwind": "^0.1.2",
    "dayjs": "^1.11.23",
    "decimal.js": "^10.6.0",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "es-toolkit": "^1.51.0",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
