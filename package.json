{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.html",
    "start": "NODE_ENV=production bun run build.ts && bun run serve",
    "serve": "bun -e \"const { serve } = require('bun'); serve({ static: { '/': './dist/index.html' }, fetch(req) { return new Response('Not Found', { status: 404 }); }, port: 3000 });\"",
    "build": "bun run lint && bun run build.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "oxlint --type-aware src",
    "lint:fix": "oxlint --type-aware --fix src",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "antd": "^6.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "dayjs": "^1.11.19",
    "decimal.js": "^10.6.0",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^4.2.0",
    "es-toolkit": "^1.44.0",
    "i18next": "^25.8.6",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.28.0",
    "oxlint": "^1.47.0",
    "oxlint-tsgolint": "^0.11.5",
    "typescript": "^5.9.3"
  }
}
